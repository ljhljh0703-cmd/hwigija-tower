{
  "schemaVersion": 2,
  "specVersion": "1.2",
  "screen": "shop",
  "sharedBy": [
    "큐 5 상점",
    "큐 6 상점 3층",
    "큐 7 상점 4층",
    "큐 8 상점 5층"
  ],
  "tokens": "ui_tokens.json",
  "checker": "Tools/check_layout.py",
  "wiringChecker": "Tools/check_wiring.py",
  "referenceResolution": {
    "width": 1080,
    "height": 1920
  },
  "layoutIntent": "살 수 있는 것과 못 사는 것을 한눈에 가르고, 못 사는 이유를 그 자리에 적는다. 판단 대상은 「무엇을 포기하는가」이고 골드가 그 조건이다.",
  "_why_one_spec": "층별로 파는 물건만 다르고 화면 구조는 같다(ENC_SHOP_01~05 전부 구매 5 + 나가기 1). 5~8번을 한 장으로 쓴다. 층 차이는 슬롯이 아니라 데이터다 — 사양을 4장 쓰면 4번 고쳐야 한다.",
  "changeFromCapture": [
    "선택지를 5행 목록으로 편다 — 구매 선택지가 5개이고 전부 DisabledVisible 이라 숨길 수 없다",
    "못 사는 항목을 숨기지 않고 각 행 안에 이유를 붙인다",
    "상단 텍스트 한 줄을 자원 칩 4개로 분해 — 골드가 이 화면의 판단 조건이다",
    "나가기 경로를 명시 — 안 사고 나갈 수 있다는 것이 보여야 한다"
  ],
  "dataBinding": {
    "_note": "2026-09-01 승격 판정. 출처 없는 슬롯은 위탁 전에 여기서 걸린다",
    "floorChip": {
      "source": "PrototypeRunSnapshot.CurrentFloor",
      "type": "int",
      "present": true
    },
    "sanityChip": {
      "source": "PrototypeRunSnapshot.Mental",
      "type": "int",
      "range": [
        -100,
        100
      ],
      "normalize": "(Mental + 100) / 200",
      "present": true,
      "note": "0~1 이 아니다"
    },
    "hpChip": {
      "source": "PrototypeRunSnapshot.PlayerHp / PlayerMaxHp",
      "type": "int",
      "present": true
    },
    "goldChip": {
      "source": "PrototypeRunSnapshot.Gold",
      "type": "int",
      "present": true,
      "note": "이 화면의 판단 조건. 강조 대상"
    },
    "ownedCount": {
      "source": "PrototypeRunSnapshot.ItemCount",
      "type": "int",
      "present": true,
      "note": "🩸 v1.1 은 `OwnedItemCount` 로 썼다 — 그런 멤버는 없다. `PrototypeRunState.CountOwnedItems()` 라는 *메서드* 이름을 보고 스냅샷 속성 이름을 유추했다. 2026-09-02 Unity 컴파일 CS1061 로 검출"
    },
    "_absent": {
      "itemPrice": "가격 전용 필드가 없다. 값은 TextKey·HintText 안 문자열이다 — 화면이 숫자를 파싱하지 않는다",
      "itemIcon": "선택지별 아이콘 참조가 데이터에 없다. 종류 아이콘은 아트 입고 후 별건",
      "shopkeeperArt": "상인 아트는 있으나 선택지와 연결하는 필드가 없다. 배경으로만 쓴다"
    },
    "offerRow": {
      "source": "PrototypeEncounterChoiceView[] (PrototypeRoomController.BuildEncounterChoiceViews)",
      "fields": "ChoiceStableId · TextKey · Visible · Enabled · ReasonTextKey · HintText",
      "present": true,
      "count": "구매 5 + 나가기 1 = 6. 실측: ENC_SHOP_01·03·04·05 전부 BUY_ITEM·BUY_OIL·BUY_CHARM·BUY_ABILITY·BUY_RECALL + LEAVE",
      "unavailablePolicyMode": "DisabledVisible — **숨길 수 없다.** 비활성으로 남는다"
    }
  },
  "constraints": [
    {
      "id": "S-01",
      "text": "누를 수 있는 요소는 y >= 0.52",
      "check": "interactive 슬롯 전부",
      "machineCheck": {
        "type": "minY",
        "value": 0.52,
        "applyTo": {
          "interactive": true
        }
      },
      "rationale": "행이 5개라 action 층을 넓혔다. 그래도 조작은 하단 절반 안"
    },
    {
      "id": "S-02",
      "text": "터치 타깃 최소 96px",
      "check": "h * 1920 >= 96",
      "machineCheck": {
        "type": "minTouchPx",
        "value": 96,
        "applyTo": {
          "interactive": true
        }
      }
    },
    {
      "id": "S-03",
      "text": "구매 행은 정확히 5개",
      "check": "role=offer 슬롯 수 == 5",
      "machineCheck": {
        "type": "count",
        "applyTo": {
          "role": [
            "offer"
          ]
        },
        "eq": 5
      },
      "rationale": "🩸 v1.0 은 3으로 썼다. 실물을 안 열고 휴식(3선택지)에서 유추했다. ENC_SHOP_01·03·04·05 실측 = 구매 5(ITEM·OIL·CHARM·ABILITY·RECALL). 2026-09-02 코덱스가 착수 전 검출"
    },
    {
      "id": "S-04",
      "text": "같은 문구가 두 슬롯에 중복되지 않는다",
      "check": "content 중복 0건",
      "machineCheck": {
        "type": "noDuplicateContent"
      }
    },
    {
      "id": "S-05",
      "text": "골드 칩은 자원 스트립 뒤쪽 끝",
      "check": "goldChip.x > 0.7",
      "machineCheck": {
        "type": "fieldBound",
        "slot": "goldChip",
        "field": "x",
        "gt": 0.7
      },
      "rationale": "이 화면의 판단 조건이라 눈이 마지막에 닿는 자리에 고정한다"
    },
    {
      "id": "S-06",
      "text": "층 순서는 resource → judgement → subject → action",
      "check": "bands 순서",
      "machineCheck": {
        "type": "bandOrder",
        "value": [
          "resource",
          "judgement",
          "subject",
          "action"
        ]
      }
    },
    {
      "id": "S-07",
      "text": "나가기 버튼은 구매 행보다 아래",
      "check": "offerRow1.y < leaveButton.y",
      "machineCheck": {
        "type": "relative",
        "a": "offerRow1",
        "b": "leaveButton",
        "field": "y",
        "op": "lt"
      }
    },
    {
      "id": "S-08",
      "text": "「붕괴도」 용어가 어떤 슬롯 문구에도 없다",
      "check": "slots[*].content 에 0건",
      "machineCheck": {
        "type": "textAbsent",
        "value": "붕괴도"
      },
      "rationale": "GDD D-012 P2"
    },
    {
      "id": "S-09",
      "text": "구매 행이 상단 정보 영역을 침범하지 않는다",
      "check": "interactive 슬롯 ⟂ y<0.52 영역",
      "machineCheck": {
        "type": "noOverlap",
        "region": {
          "x0": 0.0,
          "y0": 0.0,
          "x1": 1.0,
          "y1": 0.52
        },
        "applyTo": {
          "interactive": true
        }
      },
      "rationale": "행이 5개로 늘어 아래가 꽉 찬다. 넘치면 자원 칩·상인 씬을 덮는다"
    }
  ],
