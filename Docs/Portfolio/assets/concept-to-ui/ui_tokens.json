{
  "schemaVersion": 2,
  "kind": "global-tokens",
  "axis": "Darkest Dungeon (톤·프레임) + Chaos Zero Nightmare (붕괴 = 페널티이자 기회)",
  "referenceResolution": { "width": 1080, "height": 1920 },

  "color": {
    "voidBg":      "#0B0907",
    "panelBg":     "#17120D",
    "panelBgAlt":  "#1F1811",
    "frame":       "#4A3A24",
    "frameHi":     "#8A6A38",
    "gold":        "#C9A24A",
    "goldDim":     "#8C6E2E",
    "ink":         "#E8DFCF",
    "inkDim":      "#A2957F",
    "inkMute":     "#6B6152",
    "hp":          "#8E2F1F",
    "hpAlly":      "#5C7A4A",
    "sanity":      "#6E86A8",
    "sanityWarn":  "#B98A3C",
    "sanityBroken":"#A8425A",
    "gold_coin":   "#D8B45C"
  },

  "font": {
    "display": { "family": "명조 계열", "candidates": ["Gowun Batang", "Song Myung", "Nanum Myeongjo"], "weight": 700, "letterSpacing": 0.04, "note": "TMP 에셋으로 구울 것. 라이선스 확인 필요" },
    "body":    { "family": "고딕 계열", "candidates": ["Pretendard", "IBM Plex Sans KR"], "weight": 400 },
    "numeric": { "family": "body", "weight": 500, "tabularNums": true, "note": "HP·골드·이성 등 자릿수 정렬" }
  },

  "typeScale": {
    "title":   { "size": 96, "lineHeight": 1.12 },
    "screen":  { "size": 54, "lineHeight": 1.2 },
    "primary": { "size": 42, "lineHeight": 1.3 },
    "body":    { "size": 34, "lineHeight": 1.5 },
    "label":   { "size": 26, "lineHeight": 1.4, "letterSpacing": 0.1, "uppercase": false },
    "micro":   { "size": 22, "lineHeight": 1.4 }
  },

  "spacing": { "unit": 24, "gutter": 48, "safeTop": 0.035, "safeBottom": 0.04 },

  "frameStyle": {
    "border": { "widthPx": 3, "color": "frame", "highlight": "frameHi" },
    "corner": { "type": "ornament", "sizePx": 36, "note": "고딕 액자 코너 장식. 파티 카드의 기존 액자 언어를 전 화면으로 확장" },
    "vignette": { "strength": 0.35, "note": "이성 하락 시 강해진다. variants가 덮어씀" }
  },

  "bands": {
    "order": ["resource", "judgement", "subject", "party", "action"],
    "rule": "순서는 전 화면 고정. 비율만 화면별로 다르다. 화면에 없는 층은 비율 0."
  },

  "interaction": {
    "tapTargetMinPx": 96,
    "actionZone": { "yFrom": 0.66, "note": "누를 것은 하단 3분의 1 안에만. 예외는 spec에 forced 표기" }
  },

  "sanityStates": {
    "stable":   { "range": [0.6, 1.0], "tone": "기본", "vignette": 0.35 },
    "strained": { "range": [0.3, 0.6], "tone": "채도 -15%, 프레임 색 sanityWarn 로 이동", "vignette": 0.5 },
    "broken":   { "range": [0.0, 0.3], "tone": "채도 -35%, 프레임 sanityBroken, 아트 교체", "vignette": 0.7, "recoveryVisible": true }
  },

  "invariant": [
    "judgement 층과 action 층은 어떤 상태에서도 판독 가능하다. variants는 톤만 바꾸고 좌표·대비는 못 건드린다.",
    "붕괴 상태에서는 회복 조건이 반드시 화면에 보인다."
  ]
}
