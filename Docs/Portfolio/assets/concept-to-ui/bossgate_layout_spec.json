{
  "schemaVersion": 2,
  "specVersion": "1.0",
  "screen": "bossgate",
  "tokens": "ui_tokens.json",
  "checker": "Tools/check_layout.py",
  "wiringChecker": "Tools/check_wiring.py",
  "dataChecker": "Tools/check_databinding.py",
  "referenceResolution": {
    "width": 1080,
    "height": 1920
  },
  "layoutIntent": "돌아갈 수 없는 문 앞이라는 것을 알리고, 지금 상태로 들어갈지 정하게 한다. 선택지가 하나뿐이라 **판단 대상은 「들어갈까」가 아니라 「지금 들어가도 되나」**다 — 그래서 내 상태가 화면의 주인공이다.",
  "_why_this_shape": "🔴 실측: `ENC_COMBAT_GATE_01·02·03` 전부 **선택지 1개**(`CHOICE_COMBAT_0N_ENGAGE`). 고를 게 없으니 선택지 목록을 그리는 것은 낭비다. 대신 **자기 상태 점검판**을 크게 둔다 — 체력·이성·보유품이 판단 재료다. 이 화면이 로그라이크에서 「준비됐나」를 묻는 자리다.",
  "changeFromCapture": [
    "선택지 목록을 없앤다 — 하나뿐이라 목록이 아니다",
    "자기 상태 점검판을 subject 층 주인공으로 — 체력·이성·보유품",
    "되돌아갈 수 있는 경로를 명시 — 문 앞에서 물러날 수 있어야 한다"
  ],
  "dataBinding": {
    "_note": "2026-09-02. ENC_COMBAT_GATE_01~03 에셋 + 스냅ساط 대조",
    "floorChip": {
      "source": "PrototypeRunSnapshot.CurrentFloor",
      "type": "int",
      "present": true
    },
    "sanityChip": {
      "source": "PrototypeRunSnapshot.Mental",
      "type": "int",
      "range": [
        -100,
        100
      ],
      "normalize": "(Mental + 100) / 200",
      "present": true,
      "note": "0~1 이 아니다"
    },
    "hpChip": {
      "source": "PrototypeRunSnapshot.PlayerHp / PlayerMaxHp",
      "type": "int",
      "present": true
    },
    "goldChip": {
      "source": "PrototypeRunSnapshot.Gold",
      "type": "int",
      "present": true
    },
    "readinessPanel": {
      "source": "PrototypeRunSnapshot.PlayerHp / PlayerMaxHp / Mental / ItemCount",
      "present": true,
      "note": "판단 재료 셋. 새 「준비도」 지표를 만들지 않는다 — 그건 새 게임 수치이고 D-029 영역이다"
    },
    "gateStatus": {
      "source": "PrototypeRunSnapshot.BossGateUnlocked",
      "type": "bool",
      "present": true,
      "note": "false 면 진입 버튼 비활성"
    },
    "engageButton": {
      "source": "PrototypeRoomController.BuildEncounterChoiceViews → PrototypeEncounterChoiceView[]",
      "fields": "ChoiceStableId · TextKey · Visible · Enabled · ReasonTextKey",
      "present": true,
      "count": "**1.** ENC_COMBAT_GATE_01·02·03 전부 ENGAGE 하나뿐 (실측)"
    },
    "_absent": {
      "readinessScore": "준비도 점수 필드 없음. **만들지 않는다** — 새 수치 신설은 D-029 재검토 대상",
      "bossPreview": "보스 정보 미리보기 필드 없음. 이름·체력 어느 것도 데이터에 없다",
      "retreatChoice": "물러나기 선택지가 데이터에 없다. 지도로 돌아가는 것은 표현 층 네비게이션이다"
    }
  },
  "constraints": [
    {
      "id": "G-01",
      "text": "누를 수 있는 요소는 y >= 0.72",
      "check": "interactive 슬롯 전부",
      "machineCheck": {
        "type": "minY",
        "value": 0.72,
        "applyTo": {
          "interactive": true
        }
      }
    },
    {
      "id": "G-02",
      "text": "터치 타깃 최소 96px",
      "check": "h * 1920 >= 96",
      "machineCheck": {
        "type": "minTouchPx",
        "value": 96,
        "applyTo": {
          "interactive": true
        }
      }
    },
    {
      "id": "G-03",
      "text": "상태 점검판이 화면의 26% 이상",
      "check": "readinessPanel 면적 >= 0.26",
      "machineCheck": {
        "type": "minArea",
        "slot": "readinessPanel",
        "value": 0.26
      },
      "rationale": "선택지가 하나뿐이라 판단 재료가 화면의 주인공이어야 한다"
    },
    {
      "id": "G-04",
      "text": "같은 문구가 두 슬롯에 중복되지 않는다",
      "check": "content 중복 0건",
      "machineCheck": {
        "type": "noDuplicateContent"
      }
    },
    {
      "id": "G-05",
      "text": "진입 버튼은 정확히 1개",
      "check": "role=engage 슬롯 수 == 1",
      "machineCheck": {
        "type": "count",
        "applyTo": {
          "role": [
            "engage"
          ]
        },
        "eq": 1
      },
      "rationale": "실측 선택지 1개. 늘리면 데이터에 없는 것을 그리는 것이다"
    },
    {
      "id": "G-06",
      "text": "층 순서는 resource → judgement → subject → action",
      "check": "bands 순서",
      "machineCheck": {
        "type": "bandOrder",
        "value": [
          "resource",
          "judgement",
          "subject",
          "action"
        ]
      }
    },
    {
      "id": "G-07",
      "text": "물러나기는 진입 버튼보다 위에 두지 않는다",
      "check": "engageButton.y < retreatButton.y",
      "machineCheck": {
        "type": "relative",
        "a": "engageButton",
        "b": "retreatButton",
        "field": "y",
        "op": "lt"
      },
      "rationale": "주 동선이 위, 취소가 아래. 오조작 시 되돌리는 쪽이 엄지 끝에 있다"
    },
    {
      "id": "G-08",
      "text": "「붕괴도」 용어가 어떤 슬롯 문구에도 없다",
      "check": "slots[*].content 에 0건",
      "machineCheck": {
        "type": "textAbsent",
        "value": "붕괴도"
      },
      "rationale": "GDD D-012 P2"
    }
  ],
