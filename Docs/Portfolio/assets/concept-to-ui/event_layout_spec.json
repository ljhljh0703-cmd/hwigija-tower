{
  "schemaVersion": 2,
  "specVersion": "1.0",
  "screen": "event",
  "tokens": "ui_tokens.json",
  "checker": "Tools/check_layout.py",
  "wiringChecker": "Tools/check_wiring.py",
  "dataChecker": "Tools/check_databinding.py",
  "referenceResolution": {
    "width": 1080,
    "height": 1920
  },
  "layoutIntent": "무슨 일이 벌어졌는지 읽히고, 고를 수 있는 것과 없는 것을 가른다. 선택지 수가 크게 흔들리는 화면이라 **목록이 늘어나도 조작 위치가 안 움직이는 것**이 이 화면의 조건이다.",
  "_why_scroll": "🔴 **선택지 수 실측 = 2~14개**(41개 인카운터 전수). `EVT_F01_CULTIST_FUNERAL` 14 · `EVT_F03_BALCONY` 10 · `EVT_F02_BANDIT_DEN` 9. 최빈은 3개(19건)지만 상한이 14다. **고정 행 사양은 성립하지 않는다** — 상점(5 고정)과 다르다. 스크롤 목록 + 고정 조작부로 간다.",
  "changeFromCapture": [
    "선택지를 스크롤 목록으로 — 2~14개가 다 들어와야 한다",
    "목록이 길어져도 나가기·자원 칩 위치가 안 움직인다",
    "못 고르는 선택지의 이유를 각 행 안에 붙인다 (DisabledVisible)",
    "Hidden 정책 선택지는 표현 층에서도 그리지 않는다 — 상점과 다른 점"
  ],
  "dataBinding": {
    "_note": "2026-09-02. 41개 인카운터 에셋 전수 대조로 채웠다",
    "floorChip": {
      "source": "PrototypeRunSnapshot.CurrentFloor",
      "type": "int",
      "present": true
    },
    "sanityChip": {
      "source": "PrototypeRunSnapshot.Mental",
      "type": "int",
      "range": [
        -100,
        100
      ],
      "normalize": "(Mental + 100) / 200",
      "present": true,
      "note": "0~1 이 아니다"
    },
    "hpChip": {
      "source": "PrototypeRunSnapshot.PlayerHp / PlayerMaxHp",
      "type": "int",
      "present": true
    },
    "goldChip": {
      "source": "PrototypeRunSnapshot.Gold",
      "type": "int",
      "present": true
    },
    "choiceList": {
      "source": "PrototypeRoomController.BuildEncounterChoiceViews → PrototypeEncounterChoiceView[]",
      "fields": "ChoiceStableId · TextKey · Visible · Enabled · ReasonTextKey · HintText",
      "present": true,
      "count": "**가변 2~14.** 실측 분포 = 2개 7건 · 3개 19건 · 4개 9건 · 5개 1건 · 6개 2건 · 9개 1건 · 10개 1건 · 14개 1건 (총 41). 최빈 3, 상한 14",
      "policy": "혼재. 이벤트 대부분 DisabledVisible, `ENC_MORAL_CHOICE_*` 는 Hidden 을 함께 쓴다 → **Hidden 은 안 그린다**(Visible=false)"
    },
    "_absent": {
      "choiceIcon": "선택지별 아이콘 참조 없음",
      "eventArt": "인카운터별 아트 참조 필드 없음. 배경은 노드 종류로만 고른다",
      "choiceOrder": "표시 순서 필드 없음. 데이터 배열 순서를 그대로 쓴다"
    }
  },
  "constraints": [
    {
      "id": "E-01",
      "text": "고정 조작부는 y >= 0.86",
      "check": "interactive 중 layer=fixed",
      "machineCheck": {
        "type": "minY",
        "value": 0.86,
        "applyTo": {
          "layer": [
            "fixed"
          ]
        }
      },
      "rationale": "목록이 2개든 14개든 나가기 위치가 안 움직여야 한다"
    },
    {
      "id": "E-02",
      "text": "터치 타깃 최소 96px",
      "check": "h * 1920 >= 96",
      "machineCheck": {
        "type": "minTouchPx",
        "value": 96,
        "applyTo": {
          "interactive": true
        }
      }
    },
    {
      "id": "E-03",
      "text": "목록 뷰포트는 화면의 34% 이상",
      "check": "choiceList 면적 >= 0.34",
      "machineCheck": {
        "type": "minArea",
        "slot": "choiceList",
        "value": 0.34
      },
      "rationale": "상한 14개를 스크롤로 받으려면 한 번에 최소 3행은 보여야 한다"
    },
    {
      "id": "E-04",
      "text": "같은 문구가 두 슬롯에 중복되지 않는다",
      "check": "content 중복 0건",
      "machineCheck": {
        "type": "noDuplicateContent"
      }
    },
    {
      "id": "E-05",
      "text": "목록은 슬롯 1개다 — 행을 사양에 고정하지 않는다",
      "check": "role=choice 슬롯 수 상한 1",
      "machineCheck": {
        "type": "count",
        "applyTo": {
          "role": [
            "choice"
          ]
        },
        "max": 1
      },
      "rationale": "🔴 선택지가 2~14 로 흔들린다. 행을 슬롯으로 박으면 14개 인카운터에서 깨진다. 행은 런타임 반복이고 사양은 **뷰포트 하나**만 고정한다"
    },
    {
      "id": "E-06",
      "text": "층 순서는 resource → judgement → subject → action → fixed",
      "check": "bands 순서",
      "machineCheck": {
        "type": "bandOrder",
        "value": [
          "resource",
          "judgement",
          "subject",
          "action",
          "fixed"
        ]
      }
    },
    {
      "id": "E-07",
      "text": "목록이 고정 조작부를 덮지 않는다",
      "check": "choiceList ⟂ y>=0.86 영역",
      "machineCheck": {
        "type": "noOverlap",
        "region": {
          "x0": 0.0,
          "y0": 0.86,
          "x1": 1.0,
          "y1": 1.0
        },
        "applyTo": {
          "role": [
            "choice"
          ]
        }
      },
      "rationale": "14행이 들어와도 나가기 버튼이 가려지면 안 된다"
    },
    {
      "id": "E-08",
      "text": "「붕괴도」 용어가 어떤 슬롯 문구에도 없다",
      "check": "slots[*].content 에 0건",
      "machineCheck": {
        "type": "textAbsent",
        "value": "붕괴도"
      },
      "rationale": "GDD D-012 P2"
    }
  ],
