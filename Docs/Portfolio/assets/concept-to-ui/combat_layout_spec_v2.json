{
  "schemaVersion": 2,
  "screen": "combat",
  "supersedes": "combat_layout_spec.json (v1, 2026-07-03)",
  "tokens": "ui_tokens.json",
  "referenceResolution": {
    "width": 1080,
    "height": 1920
  },
  "sourceCapture": "Builds/PortfolioScreenshots/hwigi-tower-0739f53-20260702/06_normal_combat.png",
  "layoutIntent": "판단에 필요한 것을 먼저 읽히게 한다. 적 아트를 줄여 확보한 자리를 판단 줄 신설과 행동 버튼 확대에 쓴다.",
  "changeFromV1": [
    "적 아트 영역 60% → 38%",
    "판단 줄(threatReadout) 신설 — v1에서는 combatLog 안에 문장으로 묻혀 있었다",
    "행동 영역 7% → 26%. 엄지 도달 범위 확보",
    "topHud 를 텍스트 한 줄에서 자원 칩 4개로 분해. 이성이 끝에서 앞으로 나온다",
    "combatLog 를 판단용에서 기록용으로 강등. 접힌 상태가 기본",
    "파티 카드의 두 색 바에 의미 라벨 부여"
  ],
  "constraints": [
    {
      "id": "C-01",
      "text": "누를 수 있는 요소는 y >= 0.66 안에만 둔다",
      "check": "interactive 슬롯 전부 y >= 0.66",
      "exception": "itemInspectButton 은 read-only 라 제외",
      "machineCheck": {
        "type": "minY",
        "value": 0.66,
        "applyTo": {
          "interactive": true
        },
        "exemptSlots": [
          "itemInspectButton"
        ]
      }
    },
    {
      "id": "C-02",
      "text": "판단 줄은 적 아트보다 위에 있고 로그보다 크다",
      "check": "threatReadout.y < enemyImage.y AND threatReadout 폰트 > combatLog 폰트",
      "machineCheck": {
        "type": "relative",
        "a": "threatReadout",
        "b": "enemyImage",
        "field": "y",
        "op": "lt"
      }
    },
    {
      "id": "C-03",
      "text": "이성 칩은 자원 스트립의 첫 두 칸 안에 있다",
      "check": "sanityChip.x < 0.5",
      "machineCheck": {
        "type": "fieldBound",
        "slot": "sanityChip",
        "field": "x",
        "lt": 0.5
      }
    },
    {
      "id": "C-04",
      "text": "적의 다음 행동은 문장이 아니라 기호+숫자로 표시한다",
      "check": "threatReadout.type == 'glyphValue'",
      "machineCheck": {
        "type": "fieldEquals",
        "slot": "threatReadout",
        "field": "type",
        "value": "glyphValue"
      }
    },
    {
      "id": "C-05",
      "text": "행동 버튼 터치 타깃 최소 96px",
      "check": "행동 슬롯 h * 1920 >= 96",
      "machineCheck": {
        "type": "minTouchPx",
        "value": 96,
        "applyTo": {
          "interactive": true
        }
      }
    },
    {
      "id": "C-06",
      "text": "파티 카드의 각 바에 무엇을 나타내는지 라벨이 있다",
      "check": "hpBar·sanityBar 슬롯에 label 필드 존재",
      "machineCheck": {
        "type": "fieldRequired",
        "applyTo": {
          "hasField": "color"
        },
        "field": "label"
      }
    },
    {
      "id": "C-07",
      "text": "층 순서는 resource → judgement → subject → party → action",
      "check": "bands 순서 일치",
      "machineCheck": {
        "type": "bandOrder",
        "value": [
          "resource",
          "judgement",
          "subject",
          "party",
          "action"
        ]
      }
    },
    {
      "id": "C-08",
      "text": "어떤 variants 에서도 threatReadout 과 행동 버튼의 대비가 4.5:1 이상",
      "check": "붕괴 상태 캡처에서 대비 측정",
      "manualCheck": "런타임 캡처에서 대비 측정 필요 — 자동 채점 대상 아님"
    }
  ],
